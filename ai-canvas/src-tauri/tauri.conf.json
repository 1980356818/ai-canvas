{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "AICat",
  "version": "1.2.9",
  "identifier": "com.ai-canvas.desktop",
  "build": {
    "beforeDevCommand": "npm run check:ipc-guards && npm run version:sync && npm run dev",
    "devUrl": "http://127.0.0.1:1620",
    "beforeBuildCommand": "npm run check:ipc-guards && npm run version:sync && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI猫",
        "width": 640,
        "height": 580,
        "decorations": false,
        "visible": false,
        "center": true,
        "resizable": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**"
          ],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "copyright": "© 2024 AI猫",
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "app"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/32x32.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "template": "nsis/installer.nsi",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "compression": "lzma",
        "startMenuFolder": "AICat",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "http://101.37.80.236/api/update/check/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dangerousInsecureTransportProtocol": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0MkNDNzgyRDFERjFBNTgKUldSWUd0L1Jnc2NzcEZGNkN6dnJsbTdMbU5RS2RzWmQ1YWlwQmNtVUR4ZFBNaWxGZEZXSmp1OHYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
