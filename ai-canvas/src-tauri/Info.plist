<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS Info.plist 扩展，Tauri 构建时自动合并到最终 .app 中。
  详见 docs/mac-build-guide.md §3.6 / docs/性能与IPC规范.md §11.3。

  字段说明：
  - NSAppTransportSecurity / NSAllowsArbitraryLoads：放行 HTTP 与不在系统信任链的 HTTPS。
    上游 provider 站点（api.jjowo.com / comfly / dale 等）走 reqwest（不受 ATS 影响），
    但 WKWebView 内的 <img>/<video>/fetch 受 ATS 管控；ATS 默认阻断会让媒体预览空白。
  - LSMinimumSystemVersion：与 tauri.conf.json bundle.macOS.minimumSystemVersion 对齐。
  - NSHumanReadableCopyright / CFBundleDisplayName / CFBundleName：原生工具显示。
  - NSHighResolutionCapable：Retina 屏字体不模糊。
-->
<plist version="1.0">
<dict>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <true/>
  </dict>
  <key>LSMinimumSystemVersion</key>
  <string>12.0</string>
  <key>NSHumanReadableCopyright</key>
  <string>© 2024 AI猫</string>
  <key>CFBundleDisplayName</key>
  <string>AICat</string>
  <key>CFBundleName</key>
  <string>AICat</string>
  <key>NSHighResolutionCapable</key>
  <true/>
</dict>
</plist>
